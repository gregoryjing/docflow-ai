# DocFlow AI 环境变量示例：复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# 所有变量均可用 DOCFLOW_ 前缀，优先级：环境变量 > .env > 代码默认值

# ── 工作目录 ──────────────────────────────────────────────
# 上传件、产物、SQLite 数据库都放在这里
DOCFLOW_DATA_DIR=./data
# Schema 模板目录
DOCFLOW_SCHEMAS_DIR=./schemas
# Pipeline 规范目录（*.toml）
DOCFLOW_PIPELINES_DIR=./pipelines
# 数据库连接串；留空则用 ./data/docflow.db
# DOCFLOW_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/docflow

# ── 管线执行 / 断点续跑 ───────────────────────────────────
# 是否默认启用步骤级断点续跑；CLI 也可用 --checkpoint <目录> 单独开启
DOCFLOW_CHECKPOINT_ENABLED=false

# ── 字段映射阈值 ──────────────────────────────────────────
# 模糊匹配接受阈值：低于此值视为未映射
DOCFLOW_FUZZY_THRESHOLD=0.75
# 模糊匹配建议阈值：落在 [suggest, accept) 的映射进人工复核
DOCFLOW_FUZZY_SUGGEST_THRESHOLD=0.55

# ── 置信度三级分流 ────────────────────────────────────────
# ≥ auto：自动通过；review ~ auto：建议检查；< review：强制复核
DOCFLOW_AUTO_APPROVE_THRESHOLD=0.90
DOCFLOW_REVIEW_THRESHOLD=0.70

# ── OCR 分级链路 ──────────────────────────────────────────
# 打开后才会对图片 / 扫描件走 OCR；一级 RapidOCR 需 pip install "docflow-ai[ocr]"
DOCFLOW_OCR_ENABLED=false
# 一级 OCR 平均置信度低于此值 → 升级到二级 VL 模型
DOCFLOW_OCR_MIN_CONFIDENCE=0.85
# 扫描 PDF 渲染 DPI
DOCFLOW_PDF_RENDER_DPI=200

# ── 二级 VL 模型（OpenAI 兼容接口，Ollama / vLLM / LM Studio 均可）──
# 示例：Ollama 本地 VL 视觉模型
# DOCFLOW_VL_BASE_URL=http://127.0.0.1:11434
# DOCFLOW_VL_MODEL=qwen3-vl:8b
# DOCFLOW_VL_API_KEY=ollama
# DOCFLOW_VL_TIMEOUT_SECONDS=180

# ── 文档解析后端（可选）──────────────────────────────────
# builtin=PyMuPDF/python-docx；docling=Docling 高级版面分析（需 pip install "docflow-ai[docling]"）
DOCFLOW_DOCUMENT_BACKEND=builtin
# Docling 是否对扫描件做 OCR（需 Docling 的 OCR 依赖）
DOCFLOW_DOCLING_DO_OCR=false
# PDF 文本层字符数低于此值判定为扫描件（走 OCR）
DOCFLOW_PDF_TEXT_MIN_CHARS=40

# ── 访问控制（RBAC，交付层安全）──────────────────────────
# 关闭时所有请求视为 admin（单机 / 本地演示）；开启后从请求头读取身份
DOCFLOW_RBAC_ENABLED=false
# 请求未携带角色时的兜底角色：viewer / reviewer / operator / admin
DOCFLOW_RBAC_DEFAULT_ROLE=viewer
# 是否信任上游反向代理注入的身份头（可信代理模式）。
# 为 false（默认）时必须配置下面的签名密钥做校验；两者都没有时降级为兜底角色（fail-closed）。
DOCFLOW_RBAC_TRUST_PROXY=false
# 身份头 HMAC-SHA256 签名密钥。设置后，X-DocFlow-User/Role 必须附带合法的
# X-DocFlow-Signature，否则 401——防止客户端伪造 admin。
# 签名算法：hex(HMAC-SHA256(secret, payload))，payload = JSON 数组 [user, role]
# 的 UTF-8 字节。注意 json.dumps 的默认分隔符是「逗号 + 空格」，所以带两个元素的
# payload 实际形如 `["alice", "operator"]`（逗号后有一个空格），而不是 `["alice","operator"]`；
# 用 Python 生成时直接调 docflow.security.sign_principal(user, role, secret) 最稳妥。
# 用 JSON 数组而非 "user|role" 拼接，是为了避免 user 含 "|" 时的歧义。
# 仅在可信反向代理之后部署时可留空（由代理注入并剥离外部身份头）。
# DOCFLOW_RBAC_HEADER_SECRET=change-me

# ── Web 上传 ──────────────────────────────────────────────
# 单个上传文件大小上限（字节），默认 25MB，防止超大文件打爆内存/磁盘
DOCFLOW_MAX_UPLOAD_BYTES=26214400
# 单次上传请求体上限（字节），默认 100MB，按 Content-Length 早拒；
# 建议同时在反向代理设 client_max_body_size 形成双重防线
DOCFLOW_MAX_REQUEST_BYTES=104857600

# ── L3 字段映射（LLM 兜底，默认关闭）──────────────────────
# 仅当前两级（精确 / 模糊）都拿不准时，才把列名 + 样本数据交给文本 LLM 推断
# DOCFLOW_LLM_MAPPING_ENABLED=false
# DOCFLOW_LLM_BASE_URL=http://127.0.0.1:11434
# DOCFLOW_LLM_MODEL=qwen2.5:7b
# DOCFLOW_LLM_API_KEY=ollama
# DOCFLOW_LLM_TIMEOUT_SECONDS=60

# ── 知识检索（RAG，第二阶段）─────────────────────────────
# 对已处理数据建索引（docflow index <run_id>），支持统一检索与带引用问答
DOCFLOW_RAG_ENABLED=false
# 检索返回的片段数
DOCFLOW_RAG_TOP_K=5
# 单个检索片段的最大字符数
DOCFLOW_RAG_CHUNK_CHARS=600
# 问答生成复用上面的文本 LLM（DOCFLOW_LLM_BASE_URL / DOCFLOW_LLM_MODEL）；
# 未配置时 docflow ask 退化为「抽取式证据」，不做生成
